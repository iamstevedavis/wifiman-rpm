module wifiman-desktop 1.0;

require {
    type ifconfig_t;
    type init_t;
    type init_var_lib_t;
    type iptables_t;
    type lib_t;
    type var_lib_t;
    type http_port_t;
    type unreserved_port_t;
    class dir { add_name remove_name search write };
    class file { append create getattr ioctl open read rename setattr unlink write };
    class fifo_file open;
    class netlink_generic_socket { bind create getattr read setopt write };
    class sock_file write;
    class tcp_socket name_connect;
    type node_t;
    class rawip_socket { bind create getattr node_bind read setopt write };
}

# Current upstream daemon still writes temp/config artifacts under /usr/lib/wi-fiman-desktop
allow init_t lib_t:dir { add_name remove_name search write };
allow init_t lib_t:file { append create getattr open read rename setattr unlink write };
allow init_t lib_t:sock_file write;

# Allow runtime state/log writes under /var/lib/wifiman-desktop
allow init_t var_lib_t:dir { add_name remove_name search write };
allow init_t var_lib_t:file { append create getattr open read rename setattr unlink write };
allow init_t var_lib_t:sock_file write;
allow ifconfig_t init_var_lib_t:file { append ioctl };
allow iptables_t init_var_lib_t:file append;
allow iptables_t init_t:fifo_file open;

# Cloud auth / AWS credential bootstrap
allow init_t http_port_t:tcp_socket name_connect;

# Local UniFi gateway proxy and other high ports used by Teleport/console calls
allow init_t unreserved_port_t:tcp_socket name_connect;

# Discovery / VPN startup touches raw IP socket options, bind paths, and node binds
allow init_t self:rawip_socket { bind create getattr read setopt write };
allow init_t node_t:rawip_socket node_bind;

# WireGuard tooling uses generic netlink sockets during interface setup
allow init_t self:netlink_generic_socket { bind create getattr read setopt write };
